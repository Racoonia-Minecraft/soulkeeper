tellraw @s {"text": "Soulkeeper | Config","color": "gray"}
tellraw @s {"text": "                                ","color": "gray","strikethrough": true}

# Grave Type (How the datapack handles your death)
execute unless score #grave_type racoonia_soulkeeper.config matches 0..2 run scoreboard players set #grave_type racoonia_soulkeeper.config 1
execute if score #grave_type racoonia_soulkeeper.config matches 0 run tellraw @s ["",{text:"Grave Type ",color:"gray",hover_event:{action:"show_text",value:[{text:"How the datapack handles your death"}]}},{text:"[disabled]",underlined:true,color:"green",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'grave_type', 'value': 0}"},hover_event:{action:"show_text",value:[{text:"No on death functionality at all"}]}},{text:" "},{text:"[soul]",color:"dark_gray",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'grave_type', 'value': 1}"},hover_event:{action:"show_text",value:[{text:"Spawn a soul (grave) at the death location which stores xp and items"}]}},{text:" "},{text:"[longer despawn]",color:"dark_gray",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'grave_type', 'value': 2}"},hover_event:{action:"show_text",value:[{text:"Prevent the despawn of items for a longer time than the vanilla 5 minutes"}]}}]
execute if score #grave_type racoonia_soulkeeper.config matches 1 run tellraw @s ["",{text:"Grave Type ",color:"gray",hover_event:{action:"show_text",value:[{text:"How the datapack handles your death"}]}},{text:"[disabled]",color:"dark_gray",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'grave_type', 'value': 0}"},hover_event:{action:"show_text",value:[{text:"No on death functionality at all"}]}},{text:" "},{text:"[soul]",underlined:true,color:"green",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'grave_type', 'value': 1}"},hover_event:{action:"show_text",value:[{text:"Spawn a soul (grave) at the death location which stores xp and items"}]}},{text:" "},{text:"[longer despawn]",color:"dark_gray",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'grave_type', 'value': 2}"},hover_event:{action:"show_text",value:[{text:"Prevent the despawn of items for a longer time than the vanilla 5 minutes"}]}}]
execute if score #grave_type racoonia_soulkeeper.config matches 2 run tellraw @s ["",{text:"Grave Type ",color:"gray",hover_event:{action:"show_text",value:[{text:"How the datapack handles your death"}]}},{text:"[disabled]",color:"dark_gray",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'grave_type', 'value': 0}"},hover_event:{action:"show_text",value:[{text:"No on death functionality at all"}]}},{text:" "},{text:"[soul]",color:"dark_gray",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'grave_type', 'value': 1}"},hover_event:{action:"show_text",value:[{text:"Spawn a soul (grave) at the death location which stores xp and items"}]}},{text:" "},{text:"[longer despawn]",underlined:true,color:"green",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'grave_type', 'value': 2}"},hover_event:{action:"show_text",value:[{text:"Prevent the despawn of items for a longer time than the vanilla 5 minutes"}]}}]

# Store XP (If the soul stores xp)
execute unless score #store_xp racoonia_soulkeeper.config matches 0..1 run scoreboard players set #grave_type racoonia_soulkeeper.config 1
execute if score #grave_type racoonia_soulkeeper.config matches 1 if score #store_xp racoonia_soulkeeper.config matches 0 run tellraw @s ["",{text:"Store XP ",color:"gray",hover_event:{action:"show_text",value:[{text:"If the soul stores xp"}]}},{text:"[true]",color:"dark_gray",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'store_xp', 'value': 1}"},hover_event:{action:"show_text",value:[{text:"The soul stores xp"}]}},{text:" "},{text:"[false]",underlined:true,color:"green",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'store_xp', 'value': 0}"},hover_event:{action:"show_text",value:[{text:"The soul doesn't store xp"}]}}]
execute if score #grave_type racoonia_soulkeeper.config matches 1 if score #store_xp racoonia_soulkeeper.config matches 1 run tellraw @s ["",{text:"Store XP ",color:"gray",hover_event:{action:"show_text",value:[{text:"If the soul stores xp"}]}},{text:"[true]",underlined:true,color:"green",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'store_xp', 'value': 1}"},hover_event:{action:"show_text",value:[{text:"The soul stores xp"}]}},{text:" "},{text:"[false]",color:"dark_gray",click_event:{action:"run_command",command:"function _racoonia_soulkeeper:set_config {'key': 'store_xp', 'value': 0}"},hover_event:{action:"show_text",value:[{text:"The soul doesn't store xp"}]}}]

# Despawn Time (How long items take to despawn)
execute unless score #store_xp racoonia_soulkeeper.config matches 1..999 run scoreboard players set #despawn_time racoonia_soulkeeper.config 15
execute if score #grave_type racoonia_soulkeeper.config matches 2 run tellraw @s ["",{text:"Despawn Time ",color:"gray",hover_event:{action:"show_text",value:[{text:"How long items take to despawn (in minutes)"}]}},{score:{name:"#despawn_time",objective:"racoonia_soulkeeper.config"},color:"green",click_event:{action:"suggest_command",command:"/scoreboard players set #despawn_time racoonia_soulkeeper.config 15"},hover_event:{action:"show_text",value:[{text:"How long items take to despawn (in minutes)"}]}}]

tellraw @s ""

